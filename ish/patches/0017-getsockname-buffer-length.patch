diff --git a/tests/regress/regress_socket_name.c b/tests/regress/regress_socket_name.c
new file mode 100644
--- /dev/null
+++ b/tests/regress/regress_socket_name.c
@@ -0,0 +1,81 @@
+// getsockname must report the full address length and honor any capacity.
+// Build: aarch64-linux-musl-gcc -static -O0 -Wall -o socket_name regress_socket_name.c
+// Run:   ish -r <rootfs> /tmp/socket_name
+#define _GNU_SOURCE
+#include <errno.h>
+#include <linux/netlink.h>
+#include <netinet/in.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/syscall.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#define CHECK(cond) do { if (!(cond)) { \
+    printf("FAIL line %d (errno=%d)\n", __LINE__, errno); return 1; \
+} } while (0)
+
+static int check_name(int fd, const void *expected, socklen_t full_len) {
+    const socklen_t caps[] = {0, 1, 2, full_len - 1, full_len,
+                             full_len + 16, INT32_MAX};
+    for (size_t i = 0; i < sizeof(caps) / sizeof(caps[0]); i++) {
+        struct {
+            unsigned char before[8];
+            unsigned char addr[sizeof(struct sockaddr_storage)];
+            unsigned char after[8];
+        } out;
+        memset(&out, 0xa5, sizeof(out));
+        socklen_t len = caps[i];
+        void *addr = len ? out.addr : (void *) 1;
+        CHECK(syscall(SYS_getsockname, fd, addr, &len) == 0);
+        CHECK(len == full_len);
+        size_t copy = caps[i] < full_len ? caps[i] : full_len;
+        CHECK(memcmp(out.addr, expected, copy) == 0);
+        for (size_t j = copy; j < sizeof(out.addr); j++)
+            CHECK(out.addr[j] == 0xa5);
+        for (size_t j = 0; j < sizeof(out.before); j++)
+            CHECK(out.before[j] == 0xa5 && out.after[j] == 0xa5);
+    }
+    return 0;
+}
+
+int main(void) {
+    int fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+    CHECK(fd >= 0);
+    struct sockaddr_un un = {.sun_family = AF_UNIX};
+    snprintf(un.sun_path + 1, sizeof(un.sun_path) - 1,
+             "ish-name-%ld", (long) getpid());
+    socklen_t full_len = offsetof(struct sockaddr_un, sun_path) +
+                        1 + strlen(un.sun_path + 1);
+    CHECK(bind(fd, (struct sockaddr *) &un, full_len) == 0);
+    CHECK(check_name(fd, &un, full_len) == 0);
+
+    socklen_t len = UINT32_MAX;
+    errno = 0;
+    CHECK(syscall(SYS_getsockname, fd, (void *) 1, &len) == -1 && errno == EINVAL);
+    len = 1;
+    errno = 0;
+    CHECK(syscall(SYS_getsockname, fd, (void *) 1, &len) == -1 && errno == EFAULT);
+    close(fd);
+
+    // The host must receive a full-size buffer even when the guest has none.
+    fd = socket(AF_INET, SOCK_DGRAM, 0);
+    CHECK(fd >= 0);
+    struct sockaddr_in in = {.sin_family = AF_INET};
+    CHECK(check_name(fd, &in, sizeof(in)) == 0);
+    close(fd);
+    fd = socket(AF_NETLINK, SOCK_RAW, NETLINK_ROUTE);
+    if (fd >= 0) {
+        struct sockaddr_nl nl = {.nl_family = AF_NETLINK};
+        CHECK(check_name(fd, &nl, sizeof(nl)) == 0);
+        close(fd);
+    } else {
+        CHECK(errno == EAFNOSUPPORT);
+        puts("SKIP netlink disabled");
+    }
+    puts("PASS socket name capacities");
+    return 0;
+}
