@@ -5,6 +5,7 @@
 
 | Fix | What broke before it | Covered by |
 | --- | --- | --- |
+| P2:ISH-019 `PROT_NONE` | `write`/`writev` and `/proc/self/mem` copies accepted host `PROT_NONE` pointers and could crash the app. Rejecting an uncommitted reservation must also bypass GPF recovery so direct reads and writes still raise `SIGSEGV`, including beside a mapped page. | `regress_prot_none.c` |
 | #30 `O_DIRECTORY` flag value | `O_DIRECTORY_` carried the x86 value `1<<16` instead of aarch64's `0x4000`, so the `ENOTDIR` check never fired and `O_DIRECT` (`1<<16` on arm64) was misread as `O_DIRECTORY`. GNU `cp` over an existing file failed with `cannot create regular file '<dst>/<src>': Not a directory`. | `regress_syscall.c`, `regress_cp.sh` |
 | #30 `O_NOFOLLOW` | Translated to the host `open()`, but `generic_openat()` resolves the last path component first, so the flag was a no-op and `open(symlink, O_NOFOLLOW)` returned an fd to the target. | `regress_syscall.c` |
 | #31 fakefs `stat`/`fstat` | The hook-routed branch of `fakefs_stat()` never set `dev` (nor `nlink`/`blksize`), so `stat()` and `fstat()` disagreed on `st_dev` for one file. GNU `cp` reads that as `skipping file '...', as it was replaced while being copied`. | `regress_syscall.c`, `regress_cp.sh` |
diff --git a/tests/regress/regress_prot_none.c b/tests/regress/regress_prot_none.c
new file mode 100644
--- /dev/null
+++ b/tests/regress/regress_prot_none.c
@@ -0,0 +1,103 @@
+// PROT_NONE copies must fail without crashing the host.
+// Direct accesses, including lazy reservations, must raise SIGSEGV.
+// Build: aarch64-linux-musl-gcc -static -O0 -o regress_prot_none regress_prot_none.c
+#define _GNU_SOURCE
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <setjmp.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/mman.h>
+#include <sys/uio.h>
+#include <unistd.h>
+
+static sigjmp_buf fault_env;
+static volatile sig_atomic_t expecting_fault;
+static volatile sig_atomic_t fault_code;
+
+static void on_segv(int sig, siginfo_t *info, void *context) {
+    (void) context;
+    if (!expecting_fault)
+        _exit(128 + sig);
+    expecting_fault = 0;
+    fault_code = info->si_code;
+    siglongjmp(fault_env, 1);
+}
+
+static void check_fault(volatile char *p, int write_access) {
+    if (sigsetjmp(fault_env, 1) == 0) {
+        expecting_fault = 1;
+        if (write_access)
+            *p = 'x';
+        else
+            (void) *p;
+        expecting_fault = 0;
+        assert(0 && "PROT_NONE access did not raise SIGSEGV");
+    }
+    assert(fault_code == SEGV_ACCERR);
+}
+
+static void check_none(int fd, int memfd, char *p) {
+    errno = 0;
+    assert(write(fd, p, 1) == -1 && errno == EFAULT);
+    struct iovec iov = {.iov_base = p, .iov_len = 1};
+    errno = 0;
+    assert(writev(fd, &iov, 1) == -1 && errno == EFAULT);
+    char byte = 'x';
+    off_t off = (off_t)(uintptr_t)p;
+    // procfs currently reports a generic error for rejected debug copies.
+    assert(pread(memfd, &byte, 1, off) == -1);
+    assert(pwrite(memfd, &byte, 1, off) == -1);
+    errno = 0;
+    assert(write(fd, p, 1) == -1 && errno == EFAULT);
+}
+
+int main(void) {
+    struct sigaction action = {.sa_sigaction = on_segv, .sa_flags = SA_SIGINFO};
+    assert(sigemptyset(&action.sa_mask) == 0);
+    assert(sigaction(SIGSEGV, &action, NULL) == 0);
+    int fd = open("/dev/null", O_WRONLY);
+    int memfd = open("/proc/self/mem", O_RDWR);
+    assert(fd >= 0 && memfd >= 0);
+    long page_size = sysconf(_SC_PAGESIZE);
+    assert(page_size > 0);
+    size_t sizes[] = {128 * 1024 * 1024, (size_t)page_size};
+    for (unsigned i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+        char *p = mmap(NULL, sizes[i], PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        assert(p != MAP_FAILED);
+        // Fault before syscall copies; lazy reads and writes use separate pages.
+        check_fault(p + sizes[i] - page_size, 1);
+        check_fault(p, 0);
+        check_none(fd, memfd, p);
+        assert(mprotect(p, page_size, PROT_READ | PROT_WRITE) == 0);
+        p[0] = 'a';
+        assert(write(fd, p, 1) == 1);
+        if (sizes[i] > (size_t)page_size) {
+            // A mapped neighbour must not make untouched guard pages accessible.
+            check_fault(p + page_size, 0);
+            check_fault(p + page_size * 2, 1);
+            check_none(fd, memfd, p + page_size);
+        }
+        assert(mprotect(p, page_size, PROT_NONE) == 0);
+        check_fault(p, 0);
+        check_fault(p, 1);
+        check_none(fd, memfd, p);
+        assert(mprotect(p, page_size, PROT_READ) == 0);
+        assert(p[0] == 'a' && write(fd, p, 1) == 1);
+        assert(munmap(p, sizes[i]) == 0);
+    }
+
+    char *p = mmap(NULL, page_size * 2, PROT_READ | PROT_WRITE,
+            MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    assert(p != MAP_FAILED);
+    assert(mprotect(p + page_size, page_size, PROT_NONE) == 0);
+    errno = 0;
+    assert(write(fd, p + page_size - 1, 2) == -1 && errno == EFAULT);
+    assert(munmap(p, page_size * 2) == 0);
+    assert(close(memfd) == 0);
+    assert(close(fd) == 0);
+    puts("PASS PROT_NONE copies and faults");
+    return 0;
+}
