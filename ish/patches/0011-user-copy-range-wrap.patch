diff --git a/tests/regress/regress_user_copy.c b/tests/regress/regress_user_copy.c
new file mode 100644
--- /dev/null
+++ b/tests/regress/regress_user_copy.c
@@ -0,0 +1,73 @@
+// Build: aarch64-linux-musl-gcc -static -O0 -Wall -o usercopy regress_user_copy.c
+// Run inside iSH: /tmp/usercopy (use a realfs root to cover fast_read/fast_write)
+#define _GNU_SOURCE
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int pass, fail;
+
+static void check(int ok, const char *what) {
+    if (ok) {
+        pass++;
+        printf("  PASS  %s\n", what);
+    } else {
+        fail++;
+        printf("  FAIL  %s (errno=%d)\n", what, errno);
+    }
+}
+
+int main(void) {
+    char path[] = "/tmp/usercopy-XXXXXX";
+    int fd = mkstemp(path);
+    if (fd < 0) {
+        perror("mkstemp");
+        return 1;
+    }
+    unlink(path);
+    uintptr_t bad = UINTPTR_MAX - 15;
+    size_t sizes[] = {32, 4096, 8192};
+    for (unsigned i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+        errno = 0;
+        long res = syscall(SYS_write, fd, bad, sizes[i]);
+        check(res == -1 && errno == EFAULT, "wrapping source -> EFAULT");
+    }
+    struct stat st;
+    check(fstat(fd, &st) == 0 && st.st_size == 0, "bad writes leave the file empty");
+    check(syscall(SYS_write, fd, bad, 0) == 0, "zero-length write still succeeds");
+
+    unsigned char data[8192], copy[8192];
+    for (unsigned i = 0; i < sizeof(data); i++)
+        data[i] = i;
+    check(write(fd, data, sizeof(data)) == sizeof(data), "seed multi-page file");
+    for (unsigned i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+        check(lseek(fd, 0, SEEK_SET) == 0, "rewind before bad read");
+        errno = 0;
+        long res = syscall(SYS_read, fd, bad, sizes[i]);
+        check(res == -1 && errno == EFAULT, "wrapping destination -> EFAULT");
+    }
+    check(syscall(SYS_read, fd, bad, 0) == 0, "zero-length read still succeeds");
+    check(lseek(fd, 0, SEEK_SET) == 0, "rewind before normal read");
+    memset(copy, 0, sizeof(copy));
+    check(read(fd, copy, sizeof(copy)) == sizeof(copy), "normal multi-page read succeeds");
+    check(memcmp(copy, data, sizeof(copy)) == 0, "normal copy preserves all bytes");
+
+#if UINTPTR_MAX > UINT32_MAX
+    errno = 0;
+    uintptr_t alias = (uintptr_t) data | (UINT64_C(1) << 48);
+    check(syscall(SYS_write, fd, alias, 16) == -1 && errno == EFAULT,
+            "addresses above the guest VA do not alias mapped memory");
+    check(lseek(fd, 0, SEEK_SET) == 0, "rewind before out-of-range read");
+    errno = 0;
+    check(syscall(SYS_read, fd, alias, 16) == -1 && errno == EFAULT,
+            "out-of-range destination -> EFAULT");
+#endif
+    close(fd);
+    printf("%d passed, %d failed\n", pass, fail);
+    return fail != 0;
+}
