diff --git a/tests/regress/regress_device_bounds.c b/tests/regress/regress_device_bounds.c
new file mode 100644
--- /dev/null
+++ b/tests/regress/regress_device_bounds.c
@@ -0,0 +1,108 @@
+// Build: aarch64-linux-musl-gcc -static -O0 -Wall -o devbounds regress_device_bounds.c
+// Run in a fresh iSH instance with a fakefs root: /tmp/devbounds [--exhaust]
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+
+static int pass, fail;
+
+static void check(int ok, const char *what) {
+    if (ok) {
+        pass++;
+        printf("  PASS  %s\n", what);
+    } else {
+        fail++;
+        printf("  FAIL  %s (errno=%d)\n", what, errno);
+    }
+}
+
+static void exhaust_ptys(void) {
+    struct rlimit limit = {8192, 8192};
+    if (setrlimit(RLIMIT_NOFILE, &limit) < 0) {
+        check(0, "raise fd limit for PTY exhaustion");
+        return;
+    }
+    int fds[4097], n = 0;
+    while (n < 4097) {
+        int fd = open("/dev/ptmx", O_RDWR | O_NOCTTY);
+        if (fd < 0)
+            break;
+        fds[n++] = fd;
+    }
+    check(n > 0 && n <= 4096 && errno == ENOSPC, "full PTY table -> ENOSPC");
+    while (n > 0)
+        close(fds[--n]);
+    int fd = open("/dev/ptmx", O_RDWR | O_NOCTTY);
+    check(fd >= 0, "PTY allocation recovers after close");
+    if (fd >= 0)
+        close(fd);
+}
+
+int main(int argc, char **argv) {
+    char dir[] = "/tmp/devbounds-XXXXXX";
+    if (mkdtemp(dir) == NULL) {
+        perror("mkdtemp");
+        return 1;
+    }
+    struct {
+        mode_t type;
+        unsigned major, minor;
+    } cases[] = {
+        {S_IFCHR, 256, 0}, {S_IFCHR, 4095, 0},
+        {S_IFBLK, 256, 0}, {S_IFBLK, 4095, 0},
+        {S_IFCHR, 1, 256}, {S_IFCHR, 1, 1048575},
+        {S_IFCHR, 240, 256}, {S_IFCHR, 240, 1048575},
+        {S_IFCHR, 4, 64}, {S_IFCHR, 4, 1048575},
+        {S_IFCHR, 128, 4096}, {S_IFCHR, 128, 1048575},
+        {S_IFCHR, 136, 4096}, {S_IFCHR, 136, 1048575},
+    };
+    char path[128];
+    snprintf(path, sizeof(path), "%s/node", dir);
+    for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+        int res = mknod(path, cases[i].type | 0600, makedev(cases[i].major, cases[i].minor));
+        check(res == 0, "create device node in fakefs");
+        if (res < 0)
+            continue;
+        errno = 0;
+        int fd = open(path, O_RDWR | O_NOCTTY | O_NONBLOCK);
+        check(fd == -1 && errno == ENXIO, "out-of-range device -> ENXIO");
+        if (fd >= 0)
+            close(fd);
+        unlink(path);
+    }
+
+    struct stat st;
+    errno = 0;
+    check(stat("/dev/pts/4096", &st) == -1 && errno == ENOENT,
+            "devpts rejects index 4096");
+    errno = 0;
+    int fd = open("/dev/pts/4096", O_RDWR | O_NOCTTY);
+    check(fd == -1 && errno == ENOENT, "devpts open rejects index 4096");
+    if (fd >= 0)
+        close(fd);
+
+    int res = mknod(path, S_IFCHR | 0600, makedev(1, 3));
+    check(res == 0, "create valid null device");
+    if (res == 0) {
+        fd = open(path, O_RDONLY);
+        check(fd >= 0, "valid device still opens");
+        if (fd >= 0) {
+            char byte;
+            check(read(fd, &byte, 1) == 0, "null device still returns EOF");
+            close(fd);
+        }
+        unlink(path);
+    }
+    rmdir(dir);
+    if (argc > 1 && strcmp(argv[1], "--exhaust") == 0)
+        exhaust_ptys();
+    printf("%d passed, %d failed\n", pass, fail);
+    return fail != 0;
+}
