diff --git a/tests/regress/regress_user_string.c b/tests/regress/regress_user_string.c
new file mode 100644
--- /dev/null
+++ b/tests/regress/regress_user_string.c
@@ -0,0 +1,113 @@
+// Build: aarch64-linux-musl-gcc -static -O0 -Wall -o userstring regress_user_string.c
+// Run inside iSH with a fakefs root: /tmp/userstring
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/mount.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int pass, fail;
+
+static void check(int ok, const char *what) {
+    if (ok) {
+        pass++;
+        printf("  PASS  %s\n", what);
+    } else {
+        fail++;
+        printf("  FAIL  %s (errno=%d)\n", what, errno);
+    }
+}
+
+int main(void) {
+    char dir[] = "/tmp/userstring-XXXXXX", link[128];
+    if (mkdtemp(dir) == NULL) {
+        perror("mkdtemp");
+        return 1;
+    }
+    snprintf(link, sizeof(link), "%s/link", dir);
+    char text[4097];
+    memset(text, 'x', sizeof(text));
+    text[4096] = '\0';
+    errno = 0;
+    check(symlink(text, link) == -1 && errno == ENAMETOOLONG,
+            "unterminated target -> ENAMETOOLONG");
+    struct stat st;
+    errno = 0;
+    check(lstat(link, &st) == -1 && errno == ENOENT, "failed symlink creates nothing");
+    errno = 0;
+    int fd = open(text, O_RDONLY);
+    check(fd == -1 && errno == ENAMETOOLONG, "overlong open path -> ENAMETOOLONG");
+    if (fd >= 0)
+        close(fd);
+    errno = 0;
+    check(stat(text, &st) == -1 && errno == ENAMETOOLONG, "overlong stat path -> ENAMETOOLONG");
+    char *args[] = {text, NULL}, *env[] = {NULL};
+    errno = 0;
+    check(execve(text, args, env) == -1 && errno == ENAMETOOLONG,
+            "overlong exec path -> ENAMETOOLONG");
+    errno = 0;
+    check(mount(text, dir, "tmpfs", 0, "") == -1 && errno == ENAMETOOLONG,
+            "overlong mount source -> ENAMETOOLONG");
+    errno = 0;
+    check(mount("tmpfs", dir, "tmpfs", 0, text) == -1 && errno == ENAMETOOLONG,
+            "overlong mount data -> ENAMETOOLONG");
+    char type[101];
+    memset(type, 't', sizeof(type));
+    type[100] = '\0';
+    errno = 0;
+    check(mount("tmpfs", dir, type, 0, "") == -1 && errno == ENAMETOOLONG,
+            "overlong mount type -> ENAMETOOLONG");
+    errno = 0;
+    check(open((const char *) 1, O_RDONLY) == -1 && errno == EFAULT,
+            "unreadable path still reports EFAULT");
+
+    text[4095] = '\0';
+    int res = symlink(text, link);
+    check(res == 0, "NUL at the last permitted byte is accepted");
+    if (res == 0) {
+        char target[4096];
+        ssize_t size = readlink(link, target, sizeof(target));
+        check(size == 4095 && memcmp(target, text, 4095) == 0, "maximum target round-trips");
+        unlink(link);
+    }
+
+    size_t page = sysconf(_SC_PAGESIZE);
+    char *map = mmap(NULL, page * 2, PROT_READ | PROT_WRITE,
+            MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (map == MAP_FAILED || mprotect(map + page, page, PROT_NONE) < 0) {
+        perror("guard page");
+        rmdir(dir);
+        return 1;
+    }
+    char *name = map + page - 15;
+    memset(name, 'q', 15);
+    check(prctl(PR_SET_NAME, name, 0, 0, 0) == 0, "PR_SET_NAME truncates without probing byte 16");
+    fd = open("/proc/self/stat", O_RDONLY);
+    check(fd >= 0, "open process stat");
+    if (fd >= 0) {
+        char statbuf[1024];
+        ssize_t n = read(fd, statbuf, sizeof(statbuf) - 1);
+        check(n > 0, "read process stat");
+        if (n > 0) {
+            statbuf[n] = '\0';
+            check(strstr(statbuf, "(qqqqqqqqqqqqqqq)") != NULL, "process name keeps all 15 bytes");
+        }
+        close(fd);
+    }
+    memcpy(map + page - 4, "abc", 4);
+    check(prctl(PR_SET_NAME, map + page - 4, 0, 0, 0) == 0,
+            "short name stops at NUL before an unreadable page");
+    errno = 0;
+    check(prctl(PR_SET_NAME, (void *) 1, 0, 0, 0) == -1 && errno == EFAULT,
+            "PR_SET_NAME preserves address errors");
+    munmap(map, page * 2);
+    rmdir(dir);
+    printf("%d passed, %d failed\n", pass, fail);
+    return fail != 0;
+}
