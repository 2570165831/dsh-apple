diff --git a/tests/regress/regress_tmpfs_bounds.c b/tests/regress/regress_tmpfs_bounds.c
new file mode 100644
--- /dev/null
+++ b/tests/regress/regress_tmpfs_bounds.c
@@ -0,0 +1,86 @@
+// Build: aarch64-linux-musl-gcc -static -O0 -Wall -o tmpbounds regress_tmpfs_bounds.c
+// Run in a fresh standalone iSH instance: /tmp/tmpbounds
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mount.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int pass, fail;
+
+static void check(int ok, const char *what) {
+    if (ok) {
+        pass++;
+        printf("  PASS  %s\n", what);
+    } else {
+        fail++;
+        printf("  FAIL  %s (errno=%d)\n", what, errno);
+    }
+}
+
+int main(void) {
+    char dir[] = "/tmp/tmpbounds-XXXXXX", path[128];
+    if (mkdtemp(dir) == NULL || mount("tmpfs", dir, "tmpfs", 0, "") < 0) {
+        perror("mount tmpfs");
+        return 1;
+    }
+    snprintf(path, sizeof(path), "%s/file", dir);
+    int fd = open(path, O_CREAT | O_RDWR, 0600);
+    if (fd < 0) {
+        perror("open tmpfs file");
+        return 1;
+    }
+    unsigned char data[256], out[257];
+    memset(data, 0x5a, sizeof(data));
+    check(write(fd, data, sizeof(data)) == sizeof(data), "seed tmpfs file");
+    check(lseek(fd, 4096, SEEK_SET) == 4096, "seek beyond EOF is allowed");
+    memset(out, 0xa5, sizeof(out));
+    check(read(fd, out, sizeof(out)) == 0, "read beyond EOF returns zero");
+    check(out[0] == 0xa5 && out[256] == 0xa5, "EOF leaves destination alone");
+    check(lseek(fd, 0, SEEK_CUR) == 4096, "EOF does not move the offset");
+
+    check(lseek(fd, 8, SEEK_SET) == 8, "set a known offset");
+    errno = 0;
+    check(lseek(fd, -256, SEEK_SET) == -1 && errno == EINVAL, "negative SEEK_SET -> EINVAL");
+    check(lseek(fd, 0, SEEK_CUR) == 8, "failed SEEK_SET preserves offset");
+    errno = 0;
+    check(pread(fd, out, sizeof(out), -256) == -1 && errno == EINVAL, "negative pread -> EINVAL");
+    errno = 0;
+    check(pwrite(fd, data, sizeof(data), -256) == -1 && errno == EINVAL, "negative pwrite -> EINVAL");
+    errno = 0;
+    check(lseek(fd, -257, SEEK_END) == -1 && errno == EINVAL, "negative resulting SEEK_END -> EINVAL");
+    errno = 0;
+    check(lseek(fd, -9, SEEK_CUR) == -1 && errno == EINVAL, "negative resulting SEEK_CUR -> EINVAL");
+    errno = 0;
+    check(lseek(fd, INT64_MAX, SEEK_END) == -1 && errno == EINVAL, "overflowing SEEK_END -> EINVAL");
+    errno = 0;
+    check(lseek(fd, INT64_MAX, SEEK_CUR) == -1 && errno == EINVAL, "overflowing SEEK_CUR -> EINVAL");
+    check(lseek(fd, 0, SEEK_CUR) == 8, "all failed operations preserve offset");
+
+    check(lseek(fd, INT64_MAX - 1, SEEK_SET) == INT64_MAX - 1, "seek near signed offset limit");
+    errno = 0;
+    check(write(fd, "test", 4) == -1 && errno == EFBIG, "overflowing write -> EFBIG");
+    check(lseek(fd, 0, SEEK_CUR) == INT64_MAX - 1, "failed write preserves offset");
+    check(write(fd, "", 0) == 0, "zero-length write does not grow the file");
+    check(read(fd, out, 1) == 0, "very large EOF offset is safe");
+    struct stat st;
+    check(fstat(fd, &st) == 0 && st.st_size == 256, "failed writes preserve file size");
+
+    check(lseek(fd, 512, SEEK_SET) == 512, "seek to create a small hole");
+    check(write(fd, "Q", 1) == 1, "write after a small hole succeeds");
+    check(pread(fd, out, sizeof(out), 256) == sizeof(out), "read back the hole");
+    int zero = 1;
+    for (unsigned i = 0; i < 256; i++)
+        if (out[i] != 0)
+            zero = 0;
+    check(zero && out[256] == 'Q', "hole is zero-filled and payload is intact");
+    close(fd);
+    // tmpfs umount is unimplemented; the standalone iSH process owns this mount.
+    printf("%d passed, %d failed\n", pass, fail);
+    return fail != 0;
+}
