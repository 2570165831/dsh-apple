diff --git a/tests/regress/regress_pio.c b/tests/regress/regress_pio.c
new file mode 100644
--- /dev/null
+++ b/tests/regress/regress_pio.c
@@ -0,0 +1,62 @@
+// Positional I/O must reject descriptors without seek/read/write callbacks.
+// Build: aarch64-linux-musl-gcc -static -O0 -o regress_pio regress_pio.c
+#define _GNU_SOURCE
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/epoll.h>
+#include <sys/eventfd.h>
+#include <sys/socket.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static void check_unseekable(int fd) {
+    assert(fd >= 0);
+    uint64_t value = 1;
+    errno = 0;
+    assert(pread(fd, &value, sizeof(value), 0) == -1 && errno == ESPIPE);
+    errno = 0;
+    assert(pwrite(fd, &value, sizeof(value), 0) == -1 && errno == ESPIPE);
+}
+
+int main(void) {
+    int fd = eventfd(7, EFD_NONBLOCK);
+    check_unseekable(fd);
+    uint64_t value;
+    assert(read(fd, &value, sizeof(value)) == sizeof(value) && value == 7);
+    assert(close(fd) == 0);
+
+    fd = epoll_create1(0);
+    check_unseekable(fd);
+    assert(close(fd) == 0);
+
+    int sockets[2];
+    assert(socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) == 0);
+    check_unseekable(sockets[0]);
+    assert(close(sockets[0]) == 0);
+    assert(close(sockets[1]) == 0);
+
+    char path[] = "/tmp/ish-pio-XXXXXX";
+    fd = mkstemp(path);
+    assert(fd >= 0);
+    assert(unlink(path) == 0);
+    assert(write(fd, "abcdef", 6) == 6);
+    assert(lseek(fd, 3, SEEK_SET) == 3);
+    char buf[6];
+    assert(pread(fd, buf, 2, 1) == 2 && memcmp(buf, "bc", 2) == 0);
+    assert(lseek(fd, 0, SEEK_CUR) == 3);
+    assert(pwrite(fd, "XY", 2, 0) == 2);
+    assert(lseek(fd, 0, SEEK_CUR) == 3);
+    assert(pread(fd, buf, sizeof(buf), 0) == sizeof(buf));
+    assert(memcmp(buf, "XYcdef", sizeof(buf)) == 0);
+    errno = 0;
+    assert(syscall(SYS_pwrite64, fd, (void *)1, (size_t)8, (off_t)0) == -1 && errno == EFAULT);
+    assert(lseek(fd, 0, SEEK_CUR) == 3);
+    assert(close(fd) == 0);
+    puts("PASS positional I/O");
+    return 0;
+}
